{
  "expo": {
    "name": "RPP Auto",
    "slug": "rpp-auto-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rppautomobile.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.rppautomobile.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow RPP Auto to use your location for nearby service centers."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RPP AUTO to access your camera for VIN scanning and damage documentation."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cf3d0f50-dd9c-4b74-8497-13ece606b11a"
      }
    },
    "owner": "brotherbey765"
  }
}