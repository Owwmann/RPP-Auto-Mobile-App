# RPP Auto - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=RPP Auto
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
HOST=0.0.0.0
PORT=8000
RELOAD=True

# ============================================================================
# SUPABASE DATABASE
# ============================================================================
SUPABASE_URL=https://gfhthbmbgoxqqbzxnauv.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Direct PostgreSQL connection
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.gfhthbmbgoxqqbzxnauv.supabase.co:5432/postgres

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
JWT_SECRET_KEY=your_jwt_secret_key_here_generate_with_openssl
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# VEHICLE DATA APIs
# ============================================================================
# Motor DaaS - OBD2 Database
MOTOR_DAAS_PUBLIC_KEY=your_motor_daas_public_key
MOTOR_DAAS_PRIVATE_KEY=your_motor_daas_private_key
MOTOR_DAAS_API_URL=https://api.motor.com

# Auto.dev - VIN Decoder
AUTO_DEV_API_KEY=your_auto_dev_api_key
AUTO_DEV_API_URL=https://api.auto.dev

# ============================================================================
# AI SERVICES
# ============================================================================
# OpenRouter (Claude 3.5)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_API_URL=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-3.5-sonnet

# Hugging Face (Optional)
HUGGINGFACE_API_KEY=your_huggingface_api_key

# ============================================================================
# PAYMENT PROCESSING
# ============================================================================
# Stripe
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ============================================================================
# LOCATION SERVICES
# ============================================================================
# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ============================================================================
# COMMUNICATIONS
# ============================================================================
# Resend Email Service
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=noreply@rppauto.com

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ============================================================================
# CORS & SECURITY
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://rppauto.com
ALLOWED_HOSTS=localhost,127.0.0.1,rppauto.com

# ============================================================================
# REDIS CACHE (Optional)
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
LOG_LEVEL=INFO
SENTRY_DSN=your_sentry_dsn_here

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100
