{
  "cli": {
    "version": ">= 10.0.0",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "gradleCommand": ":app:assembleDebug",
        "resourceClass": "medium",
        "image": "latest"
      },
      "ios": {
        "resourceClass": "medium",
        "simulator": true,
        "image": "latest"
      },
      "node": "20.10.0"
    },
    "preview": {
      "distribution": "internal",
      "extends": "production",
      "channel": "preview"
    },
    "production": {
      "channel": "production",
      "node": "20.10.0",
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "medium",
        "image": "latest"
      },
      "ios": {
        "resourceClass": "large",
        "image": "latest"
      }
    }
  }
}