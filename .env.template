# RPP Auto - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ===========================================
# SUPABASE (Backend & Database)
# ===========================================
SUPABASE_URL=https://[your-project-id].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
JWT_SECRET=your_jwt_secret_key_here

# ===========================================
# AI & MACHINE LEARNING
# ===========================================
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional: Hugging Face (for additional ML features)
HUGGINGFACE_API_KEY=hf_...

# ===========================================
# VEHICLE DATA APIS
# ===========================================
# Motor DaaS - OBD2 Database
MOTOR_DAAS_PUBLIC_KEY=...
MOTOR_DAAS_PRIVATE_KEY=...
MOTOR_DAAS_BASE_URL=https://api.motordaas.com

# Auto.dev - VIN Decoding
AUTODEV_API_KEY=sk_ad_...
AUTODEV_BASE_URL=https://api.auto.dev

# ===========================================
# GOOGLE SERVICES
# ===========================================
GOOGLE_MAPS_API_KEY=AIzaSy...
GOOGLE_PLACES_API_KEY=AIzaSy...
FIREBASE_CONFIG_JSON=path/to/google-services.json

# ===========================================
# PAYMENT PROCESSING (Stripe)
# ===========================================
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ===========================================
# EMAIL SERVICE (Resend)
# ===========================================
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@rppauto.com

# ===========================================
# ANALYTICS & MONITORING
# ===========================================
FIREBASE_APP_ID=...
FIREBASE_MEASUREMENT_ID=...
SENTRY_DSN=https://...@sentry.io/...

# ===========================================
# ENVIRONMENT CONFIGURATION
# ===========================================
ENVIRONMENT=development  # development, staging, production
DEBUG_MODE=true
LOG_LEVEL=debug  # debug, info, warn, error

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_OBD2_HARDWARE=false  # Enable OBD2 Bluetooth integration
ENABLE_AI_DIAGNOSTICS=true  # Enable AI-powered diagnostics
ENABLE_PAYMENTS=false  # Enable Stripe payment processing
ENABLE_ANALYTICS=true  # Enable Firebase Analytics

# ===========================================
# RATE LIMITING & QUOTAS
# ===========================================
API_RATE_LIMIT_PER_MINUTE=60
AI_REQUESTS_PER_DAY=1000
OBD2_SCANS_PER_DAY=50

# ===========================================
# NOTES
# ===========================================
# 1. All API keys should be obtained from respective service providers
# 2. Never share or commit real API keys
# 3. Use separate keys for development and production
# 4. Rotate keys regularly for security
# 5. Monitor API usage and costs